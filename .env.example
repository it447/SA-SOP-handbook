# Copy this file to .env.local and fill in real values.
# Never commit real secrets — this file must only ever contain placeholders.

# --- Generation (Claude via OpenRouter) ---
# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenRouter model id to use for chat generation, e.g. "anthropic/claude-sonnet-5"
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Embeddings (Voyage AI) ---
# Voyage AI API key. Get one at https://dash.voyageai.com/
VOYAGE_API_KEY=
# Voyage embedding model. voyage-2 produces 1024-dim vectors, which is what the
# kb_chunks.embedding column (vector(1024)) is sized for below. If you change the
# model to one with a different output dimension, update the column definition
# in src/lib/db.ts to match.
VOYAGE_MODEL=voyage-2

# --- Vector store (Vercel Postgres + pgvector) ---
# Connection string for a Vercel Postgres (or any Postgres with the pgvector
# extension available) database. @vercel/postgres reads this automatically.
POSTGRES_URL=

# --- Auth (invite-only, custom email/password) ---
# Shared secret that unlocks the /admin portal (invite people, revoke access).
# Not tied to any user account. Generate with: openssl rand -base64 32
ADMIN_SECRET=
# Base URL used in invite emails, e.g. https://sa-sop-handbook.vercel.app
# Falls back to the request's own host if unset.
APP_URL=

# --- Transactional email (invite emails via Resend) ---
# Get a key at https://resend.com. The default sender below works without
# verifying a domain, for testing; verify Scale Army's domain in Resend for
# reliable delivery to real teammates.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
